{
  "name": "hcmusware",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ui": "node scripts/ui-test.js",
    "test:e2e": "node --env-file=.env.local scripts/e2e-tuan5.js",
    "test:e2e:online": "node --env-file=.env.online.local scripts/e2e-tuan5.js",
    "test:e2e:g2t2": "node --env-file=.env.local scripts/e2e-g2t2.js",
    "test:e2e:g2t2:online": "node --env-file=.env.online.local scripts/e2e-g2t2.js",
    "test:e2e:g2t3": "node --env-file=.env.local scripts/e2e-g2t3.js",
    "test:e2e:g2t3:online": "node --env-file=.env.online.local scripts/e2e-g2t3.js",
    "test:e2e:g2t4": "node --env-file=.env.local scripts/e2e-g2t4.js",
    "test:e2e:g2t4:online": "node --env-file=.env.online.local scripts/e2e-g2t4.js",
    "test:rls": "node --env-file=.env.local scripts/rls-test.js",
    "test:rls:online": "node --env-file=.env.online.local scripts/rls-test.js",
    "test:roles": "node --env-file=.env.local scripts/role-test.js",
    "test:roles:online": "node --env-file=.env.online.local scripts/role-test.js https://hcmusware.vercel.app",
    "test:regression:online": "node --env-file=.env.online.local scripts/regression-readonly.js https://hcmusware.vercel.app",
    "test:lighthouse": "node scripts/lighthouse.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:backup": "node --env-file=.env.online.local scripts/backup-db.js",
    "db:backup:local": "node --env-file=.env.local scripts/backup-db.js",
    "import-data": "node --env-file=.env.local scripts/import-dataset.js",
    "gen-price-history": "node --env-file=.env.local scripts/gen-price-history.js",
    "fetch-images": "node scripts/fetch-images.js",
    "thumbs": "node scripts/make-thumbs.js",
    "brand-logos": "node scripts/fetch-brand-logos.js",
    "brand-logos:apply": "node --env-file=.env.local scripts/fetch-brand-logos.js --apply",
    "brand-logos:apply:online": "node --env-file=.env.online.local scripts/fetch-brand-logos.js --apply",
    "build-dvhc": "node scripts/build-dvhc.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/vite": "^4.1.4",
    "chart.js": "^4.4.9",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.1",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
