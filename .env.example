# Chép file này thành .env.local rồi điền khóa thật (Kiến trúc sư gửi qua nhóm chat).
# .env.local đã nằm trong .gitignore – không bao giờ commit.

# Dùng cho web (an toàn để lộ ra trình duyệt vì đã có RLS bảo vệ)
# - Local:  URL là http://127.0.0.1:54321, key lấy từ lệnh `npm run db:status` (dòng Publishable / anon key)
# - Online: lấy trong Supabase → Project Settings → API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# CHỈ dùng cho script trong thư mục scripts/ chạy trên máy (import dữ liệu).
# Tuyệt đối không đặt tên có tiền tố VITE_ và không dùng trong src/.
SUPABASE_SERVICE_ROLE_KEY=

# Tỷ giá quy đổi khi import dữ liệu
USD_TO_VND=26000
